      "source": [
        "# Journal des transformations : chaque étape, sa justification, lignes avant/après\n",
        "journal_nettoyage = []\n",
        "\n",
        "def noter(etape, justification, avant, apres):\n",
        "    journal_nettoyage.append({'etape': etape, 'justification': justification,\n",
        "                              'lignes_avant': avant, 'lignes_apres': apres})\n",
        "\n",
        "# 1. Sélection des 11 colonnes retenues (voir section 4)\n",
        "colonnes_gardees = ['refYear', 'reporterCode', 'partnerCode', 'flowCode', 'cmdCode',\n",
        "                    'classificationCode', 'primaryValue', 'fobvalue',\n",
        "                    'isReported', 'isAggregate', 'legacyEstimationFlag']\n",
        "df = donnees_brutes[colonnes_gardees].copy()\n",
        "noter('Sélection de 11 colonnes sur 47',\n",
        "      'Colonnes vides, constantes ou hors sujet (voir section 4)', len(donnees_brutes), len(df))\n",
        "\n",
        "# 2. Valeurs manquantes\n",
        "print('Valeurs manquantes par colonne :')\n",
        "print(df.isna().sum().to_string())\n",
        "\n",
        "# 3. Doublons (une seule ligne attendue par année)\n",
        "print(\"\\nDoublons sur l'année :\", df.duplicated(subset='refYear').sum())\n",
        "\n",
        "# 4. Contrôle de la requête : toutes les lignes sont-elles Maroc / Monde / Export / HS 07 ?\n",
        "controle = (df['reporterCode'].eq(504).all() and df['partnerCode'].eq(0).all()\n",
        "            and df['flowCode'].eq('X').all()\n",
        "            and df['cmdCode'].astype(str).str.zfill(2).eq('07').all())\n",
        "print('Toutes les lignes correspondent à Maroc / Monde / X / 07 :', controle)\n",
        "\n",
        "# 5. Cohérence des valeurs\n",
        "print('Valeurs nulles ou négatives dans primaryValue :', (df['primaryValue'] <= 0).sum())\n",
        "ecart = (df['primaryValue'] - df['fobvalue']).abs()\n",
        "print('Écart maximal entre primaryValue et fobvalue :', ecart.max())\n",
        "\n",
        "# 6. Continuité de la série\n",
        "df = df.sort_values('refYear').reset_index(drop=True)\n",
        "annees = df['refYear'].tolist()\n",
        "print('Série continue (aucune année sautée) :', annees == list(range(annees[0], annees[-1] + 1)))\n",
        "noter('Tri par année', 'Mettre la série dans l\\'ordre chronologique', len(df), len(df))\n",
        "\n",
        "# 7. Indicateurs de qualité année par année (inspection uniquement, pas des variables du modèle)\n",
        "inspection = df[['refYear', 'classificationCode', 'isReported', 'isAggregate', 'legacyEstimationFlag']].copy()\n",
        "inspection['valeur_mrd_usd'] = (df['primaryValue'] / 1e9).round(3)\n",
