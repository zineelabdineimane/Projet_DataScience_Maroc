        "def construire_variables(donnees):\n",
        "    \"\"\"Pour chaque année t : variables connues à la fin de t, et cibles en t+1.\"\"\"\n",
        "    y = donnees.sort_values('annee').set_index('annee')['valeur_usd']\n",
        "    tab = pd.DataFrame(index=y.index)\n",
        "\n",
        "    # Variables explicatives (uniquement des informations disponibles à la fin de l'année t)\n",
        "    tab['valeur_t'] = y\n",
        "    tab['valeur_t_1'] = y.shift(1)\n",
        "    tab['croissance_t'] = y.pct_change()\n",
        "    tab['croissance_t_1'] = tab['croissance_t'].shift(1)\n",
        "    tab['croissance_moy_passee'] = tab['croissance_t'].expanding().mean()\n",
        "    tab['tendance'] = tab.index - tab.index.min()\n",
        "\n",
        "    # Cibles (année t+1) : jamais utilisées comme variables explicatives\n",
        "    tab['cible_valeur_t1'] = y.shift(-1)\n",
        "    tab['cible_croissance_t1'] = tab['cible_valeur_t1'] / tab['valeur_t'] - 1\n",
        "    return tab\n",
        "\n",
        "\n",
        "VARIABLES = ['valeur_t', 'valeur_t_1', 'croissance_t', 'croissance_t_1',\n",
        "             'croissance_moy_passee', 'tendance']\n",
        "CIBLE = 'cible_valeur_t1'\n",
        "CIBLE_CROISSANCE = 'cible_croissance_t1'\n",
        "\n",
        "tableau = construire_variables(donnees)\n",
        "\n",
        "# Lignes utilisables pour l'apprentissage : toutes les variables ET la cible sont connues\n",
        "donnees_modele = tableau.dropna(subset=VARIABLES + [CIBLE])\n",
        "# Ligne de prévision : dernière année observée (2024), cible 2025 inconnue\n",
        "ligne_prevision = tableau.loc[[tableau.index.max()], VARIABLES]\n",
        "\n",
        "print(f'Lignes utilisables : {len(donnees_modele)} '\n",
        "      f'(t = {donnees_modele.index.min()} à {donnees_modele.index.max()}, '\n",
        "      f'cibles {donnees_modele.index.min() + 1} à {donnees_modele.index.max() + 1})')\n",
        "print('Ligne de prévision : t =', ligne_prevision.index[0], '(pour prévoir', ligne_prevision.index[0] + 1, ')')\n",
        "\n",
        "# Affichage lisible : valeurs en milliards USD, croissances en %\n",
        "apercu = donnees_modele.copy()\n",
        "for c in ['valeur_t', 'valeur_t_1', 'cible_valeur_t1']:\n",
        "    apercu[c] = (apercu[c] / 1e9).round(3)\n",
        "for c in ['croissance_t', 'croissance_t_1', 'croissance_moy_passee', 'cible_croissance_t1']:\n",
        "    apercu[c] = (apercu[c] * 100).round(1)\n",
        "display(apercu)\n",
        "\n",
        "# Test anti-fuite : on multiplie par 10 la valeur de 2024.\n",
        "# Si les variables des années 2010 à 2023 ne changent pas, aucune ne dépend du futur.\n",
        "donnees_test = donnees.copy()\n",
        "donnees_test.loc[donnees_test['annee'] == 2024, 'valeur_usd'] *= 10\n",
        "tableau_test = construire_variables(donnees_test)\n",
        "inchangees = tableau.loc[:2023, VARIABLES].equals(tableau_test.loc[:2023, VARIABLES])\n",
        "print('Test anti-fuite : variables 2010–2023 inchangées après modification de 2024 :', inchangees)\n",
        "\n",
        "tableau.to_csv(DOSSIER_DATA / 'variables_modele.csv')"
      ]
