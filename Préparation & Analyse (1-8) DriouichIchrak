        "import requests\n",
        "import time\n",
        "import json\n",
        "from datetime import datetime\n",
        "\n",
        "FICHIER_BRUT = DOSSIER_DATA / 'comtrade_maroc_HS07_X_2010_2024_brut.csv'\n",
        "FICHIER_JOURNAL = DOSSIER_DATA / 'journal_requetes.csv'\n",
        "FORCER_TELECHARGEMENT = False   # mettre True pour réinterroger l'API\n",
        "\n",
        "\n",
        "def telecharger_annee(annee, tentatives=3, pause=5, params_base=None):\n",
        "    \"\"\"Interroge l'API pour une année. Renvoie (lignes, infos pour le journal).\"\"\"\n",
        "    params = {**(params_base or PARAMS_BASE), 'period': annee}\n",
        "    statut, message = None, ''\n",
        "    for essai in range(1, tentatives + 1):\n",
        "        try:\n",
        "            rep = requests.get(URL_API, params=params, timeout=30)\n",
        "            statut = rep.status_code\n",
        "            if statut == 200:\n",
        "                contenu = rep.json()\n",
        "                if contenu.get('error'):                      # erreur renvoyée par l'API\n",
        "                    return [], {'statut': statut, 'nb_lignes': 0, 'message': contenu['error']}\n",
        "                lignes = contenu.get('data') or []\n",
        "                message = 'ok' if lignes else 'réponse vide'   # cas de données vides\n",
        "                return lignes, {'statut': statut, 'nb_lignes': len(lignes), 'message': message}\n",
        "            message = f'erreur HTTP {statut}'                  # 429 = trop de requêtes, 5xx = serveur\n",
        "        except (requests.RequestException, ValueError) as e:\n",
        "            message = f'erreur réseau ou JSON : {e}'\n",
        "        print(f'  {annee} : essai {essai} échoué ({message}), nouvel essai dans {pause} s')\n",
        "        time.sleep(pause)\n",
        "    return [], {'statut': statut, 'nb_lignes': 0, 'message': message}\n",
        "\n",
        "\n",
        "if FICHIER_BRUT.exists() and not FORCER_TELECHARGEMENT:\n",
        "    # Les données ont déjà été téléchargées : on relit le fichier local\n",
        "    donnees_brutes = pd.read_csv(FICHIER_BRUT, dtype={'cmdCode': str})\n",
        "    journal = pd.read_csv(FICHIER_JOURNAL)\n",
        "    print('Données relues depuis le fichier local :', FICHIER_BRUT)\n",
        "else:\n",
        "    toutes_lignes, lignes_journal = [], []\n",
        "    for annee in ANNEES:\n",
        "        lignes, info = telecharger_annee(annee)\n",
        "        toutes_lignes.extend(lignes)\n",
        "        lignes_journal.append({\n",
        "            'date_extraction': datetime.now().strftime('%Y-%m-%d %H:%M'),\n",
        "            'annee': annee, **info,\n",
        "            'url': URL_API,\n",
        "            'parametres': json.dumps({**PARAMS_BASE, 'period': annee}),\n",
        "        })\n",
        "        print(f\"{annee} : {info['message']} ({info['nb_lignes']} ligne(s))\")\n",
        "        time.sleep(1.5)                                        # pause entre deux appels\n",
        "\n",
        "    donnees_brutes = pd.DataFrame(toutes_lignes)\n",
        "    journal = pd.DataFrame(lignes_journal)\n",
        "    if donnees_brutes.empty:\n",
        "        raise RuntimeError(\"Aucune donnée reçue : vérifier la connexion et le journal des requêtes.\")\n",
        "    donnees_brutes.to_csv(FICHIER_BRUT, index=False)\n",
        "    journal.to_csv(FICHIER_JOURNAL, index=False)\n",
        "    print('\\nFichiers sauvegardés dans', DOSSIER_DATA)\n",
        "\n",
        "# Dimensions et colonnes\n",
        "print('\\nDimensions :', donnees_brutes.shape)\n",
        "print('Colonnes :', list(donnees_brutes.columns))\n",
        "\n",
        "# Aperçu des colonnes utiles\n",
        "colonnes_utiles = ['refYear', 'reporterCode', 'partnerCode', 'flowCode',\n",
        "                   'cmdCode', 'classificationCode', 'primaryValue']\n",
        "display(donnees_brutes[colonnes_utiles].sort_values('refYear'))\n",
        "\n",
        "# Années manquantes\n",
        "annees_manquantes = sorted(set(ANNEES) - set(donnees_brutes['refYear']))\n",
        "print('Années manquantes :', annees_manquantes if annees_manquantes else 'aucune')\n",
        "\n",
        "display(journal)"
      ]
