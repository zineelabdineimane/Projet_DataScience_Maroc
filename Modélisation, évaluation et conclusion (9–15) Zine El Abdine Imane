        "        essais.append({'famille': 'Ridge', 'cible': cible, 'reglages': f'alpha={alpha}',\n",
        "                       'params': params, **score_cv(creer_ridge(**params), cible)})\n",
        "    for n, prof, lr in product(*ESPACE_GBR.values()):\n",
        "        params = {'n_estimators': n, 'max_depth': prof, 'learning_rate': lr}\n",
        "        essais.append({'famille': 'Gradient Boosting', 'cible': cible,\n",
        "                       'reglages': f'arbres={n}, profondeur={prof}, taux={lr}',\n",
