        "    \"\"\"Pour chaque t : entraînement sur les années antérieures (ou les `fenetre` dernières), prévision de t+1.\"\"\"\n",
        "    previsions = {}\n",
        "    for t in ANNEES_T_GLISSANT:\n",
        "        if cible == 'regle':                         # référence : règle fixe, pas d'entraînement\n",
        "            previsions[t] = modele(X.loc[[t]])[0]\n",
        "            continue\n",
        "        X_app = X.loc[X.index < t]\n",
        "        if fenetre:\n",
        "            X_app = X_app.loc[X_app.index >= t - fenetre]\n",
        "        previsions[t] = ajuster_predire(modele, X_app, X.loc[[t]], cible)[0]\n",
        "    return pd.Series(previsions)\n",
        "\n",
        "CANDIDATS = {**{nom: (regle, 'regle') for nom, regle in REFERENCES.items()}, **MODELES_REGLES}\n",
