        "# Prévision 2025 : modèles réentraînés sur toutes les observations (t = 2012–2023)\n",
        "valeur_2024 = ligne_prevision['valeur_t'].iloc[0]\n",
        "cr_moy_2024 = ligne_prevision['croissance_moy_passee'].iloc[0]\n",
        "\n",
        "prev_2025 = {'Persistance + croissance moyenne (méthode retenue)': persistance_croissance(ligne_prevision)[0]}\n",
        "for nom in ['Ridge (croissance) réglé', 'Gradient Boosting (croissance) réglé']:\n",
        "    modele, cible = MODELES_REGLES[nom]\n",
        "    prev_2025[nom] = ajuster_predire(modele, X, ligne_prevision, cible)[0]\n",
        "\n",
        "# Fourchette à 80 % : quantiles des erreurs passées de la méthode retenue (section 13)\n",
        "centrale = prev_2025['Persistance + croissance moyenne (méthode retenue)']\n",
        "borne_basse, borne_haute = centrale * (1 + Q_BASSE), centrale * (1 + Q_HAUTE)\n",
        "\n",
        "# Scénarios illustratifs tirés des données observées\n",
        "cr_recente = croissance.loc[2021:2024].mean() / 100\n",
        "scenarios = {\n",
        "    'Scénario : rythme récent (croissance moyenne 2021–2024)': valeur_2024 * (1 + cr_recente),\n",
        "    'Scénario : choc comparable à 2012 (plus forte baisse observée)': valeur_2024 * (1 + croissance.min() / 100),\n",
        "}\n",
        "\n",
        "tableau_2025 = pd.Series({**prev_2025,\n",
        "                          'Borne basse de la fourchette (80 %)': borne_basse,\n",
        "                          'Borne haute de la fourchette (80 %)': borne_haute,\n",
        "                          **scenarios}).to_frame('valeur_2025_mrd_usd')\n",
        "tableau_2025['variation_vs_2024_%'] = (tableau_2025['valeur_2025_mrd_usd'] / valeur_2024 - 1) * 100\n",
        "tableau_2025['valeur_2025_mrd_usd'] /= 1e9\n",
        "print(f'Valeur 2024 : {valeur_2024 / 1e9:.3f} Md$ | croissance moyenne passée utilisée : {cr_moy_2024 * 100:.1f} %')\n",
        "display(tableau_2025.round(3))\n",
        "tableau_2025.to_csv(DOSSIER_DATA / 'prevision_2025.csv')\n",
        "\n",
        "# Figure : série observée, prévision 2025, fourchette et scénarios\n",
        "fig, ax = plt.subplots(figsize=(9, 4.5))\n",
        "ax.plot(serie_mrd.index, serie_mrd.values, 'k-o', label='Valeur observée')\n",
        "ax.plot([2024, 2025], [valeur_2024 / 1e9, centrale / 1e9], ':', color='tab:orange')\n",
        "ax.errorbar(2025, centrale / 1e9,\n",
        "            yerr=[[(centrale - borne_basse) / 1e9], [(borne_haute - centrale) / 1e9]],\n",
        "            fmt='o', color='tab:orange', capsize=6, markersize=8,\n",
        "            label='Prévision 2025 et fourchette à 80 %')\n",
        "for (nom, v), m, c in zip(scenarios.items(), ['^', 'v'], ['tab:green', 'tab:red']):\n",
        "    ax.scatter(2025.2, v / 1e9, marker=m, color=c, s=60, zorder=3, label=nom)\n",
        "ax.set(title='Exportations marocaines de légumes (HS 07) : prévision pour 2025',\n",
        "       xlabel='Année', ylabel='Valeur exportée (milliards USD)')\n",
        "ax.set_xticks(range(2010, 2026))\n",
        "ax.tick_params(axis='x', rotation=45)\n",
        "ax.legend(fontsize=7, loc='upper left')\n",
