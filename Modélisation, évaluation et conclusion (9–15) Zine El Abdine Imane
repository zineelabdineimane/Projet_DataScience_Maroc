        "def metriques(y_vrai, y_pred):\n",
        "    \"\"\"MAE, RMSE (en USD) et WAPE (proportion).\"\"\"\n",
        "    y_vrai, y_pred = np.asarray(y_vrai, dtype=float), np.asarray(y_pred, dtype=float)\n",
        "    erreur = y_vrai - y_pred\n",
        "    return {'MAE': np.mean(np.abs(erreur)),\n",
        "            'RMSE': np.sqrt(np.mean(erreur ** 2)),\n",
        "            'WAPE': np.sum(np.abs(erreur)) / np.sum(np.abs(y_vrai))}\n",
        "\n",
        "\n",
        "# Les deux modèles de référence (aucun apprentissage, uniquement des variables connues en t)\n",
        "def persistance(X):\n",
        "    return X['valeur_t'].values\n",
        "\n",
        "def persistance_croissance(X):\n",
        "    return (X['valeur_t'] * (1 + X['croissance_moy_passee'])).values\n",
        "\n",
        "REFERENCES = {'Persistance': persistance,\n",
        "              'Persistance + croissance moyenne': persistance_croissance}\n",
        "\n",
        "# Tableau de résultats commun à tous les modèles\n",
        "resultats = []\n",
        "\n",
        "def enregistrer(modele, jeu, scores):\n",
        "    for metrique, valeur in scores.items():\n",
        "        resultats.append({'modele': modele, 'jeu_evalue': jeu, 'metrique': metrique, 'valeur': valeur})\n",
        "\n",
        "\n",
        "# 1. Évaluation sur la validation (années prévues 2020 et 2021)\n",
        "predictions_val = pd.DataFrame({'annee_prevue': y_val.index + 1,\n",
        "                                'reel_mrd_usd': y_val.values / 1e9}, index=y_val.index)\n",
        "for nom, regle in REFERENCES.items():\n",
        "    pred = regle(X_val)\n",
        "    predictions_val[nom] = pred / 1e9\n",
        "    enregistrer(nom, 'validation (2020–2021)', metriques(y_val, pred))\n",
        "print('Prévisions sur la validation (milliards USD) :')\n",
        "display(predictions_val.round(3))\n",
        "\n",
        "# 2. Évaluation sur les 5 plis de la validation croisée (années prévues 2017 à 2021)\n",
        "for nom, regle in REFERENCES.items():\n",
        "    vrais, preds = [], []\n",
        "    for _, idx_va in cv_temporelle.split(X_trainval):\n",
        "        vrais.extend(y_trainval.iloc[idx_va])\n",
        "        preds.extend(regle(X_trainval.iloc[idx_va]))\n",
        "    enregistrer(nom, 'validation croisée (2017–2021)', metriques(vrais, preds))\n",
        "\n",
        "# Tableau récapitulatif lisible : MAE et RMSE en millions USD, WAPE en %\n",
        "recap = (pd.DataFrame(resultats)\n",
        "         .pivot_table(index=['modele', 'jeu_evalue'], columns='metrique', values='valeur'))\n",
        "recap['MAE (M$)'] = (recap['MAE'] / 1e6).round(1)\n",
        "recap['RMSE (M$)'] = (recap['RMSE'] / 1e6).round(1)\n",
        "recap['WAPE (%)'] = (recap['WAPE'] * 100).round(1)\n",
        "display(recap[['MAE (M$)', 'RMSE (M$)', 'WAPE (%)']])"
