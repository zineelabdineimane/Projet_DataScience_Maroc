        "from sklearn.linear_model import Ridge\n",
        "from sklearn.ensemble import GradientBoostingRegressor\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.base import clone\n",
        "\n",
        "\n",
        "def creer_ridge(alpha=1.0):\n",
        "    # Standardisation indispensable : les variables ont des échelles très différentes\n",
        "    return Pipeline([('standardisation', StandardScaler()),\n",
        "                     ('ridge', Ridge(alpha=alpha))])\n",
        "\n",
        "def creer_gbr(**params):\n",
        "    # Les arbres n'ont pas besoin de standardisation ; le pipeline garde une structure commune\n",
        "    reglages = dict(n_estimators=100, max_depth=2, learning_rate=0.1,\n",
        "                    random_state=GRAINE_ALEATOIRE)\n",
        "    reglages.update(params)\n",
        "    return Pipeline([('gbr', GradientBoostingRegressor(**reglages))])\n",
        "\n",
        "\n",
        "def ajuster_predire(modele, X_app, X_pred, cible):\n",
        "    \"\"\"Entraîne une copie neuve du modèle sur X_app et renvoie des prévisions en valeur (USD).\"\"\"\n",
        "    m = clone(modele)\n",
        "    if cible == 'niveau':\n",
        "        m.fit(X_app, y.loc[X_app.index])\n",
        "        return m.predict(X_pred)\n",
        "    # cible = 'croissance' : on prévoit le taux, puis on le reconvertit en valeur\n",
        "    m.fit(X_app, y_croissance.loc[X_app.index])\n",
        "    return X_pred['valeur_t'].values * (1 + m.predict(X_pred))\n",
        "\n",
        "\n",
        "def evaluer(nom, modele, cible):\n",
        "    \"\"\"Évalue un modèle sur la validation et sur la validation croisée temporelle.\"\"\"\n",
        "    # Validation : entraînement sur 2012–2018, prévision de 2020 et 2021\n",
        "    pred_val = ajuster_predire(modele, X_train, X_val, cible)\n",
        "    enregistrer(nom, 'validation (2020–2021)', metriques(y_val, pred_val))\n",
        "    # Validation croisée : un nouvel entraînement par pli, sur les seules années passées\n",
        "    vrais, preds = [], []\n",
        "    for idx_tr, idx_va in cv_temporelle.split(X_trainval):\n",
        "        vrais.extend(y_trainval.iloc[idx_va])\n",
        "        preds.extend(ajuster_predire(modele, X_trainval.iloc[idx_tr], X_trainval.iloc[idx_va], cible))\n",
        "    enregistrer(nom, 'validation croisée (2017–2021)', metriques(vrais, preds))\n",
        "    return pred_val\n",
        "\n",
        "\n",
        "def tableau_recap(jeu):\n",
        "    \"\"\"Tableau lisible des résultats pour un jeu d'évaluation, trié par WAPE.\"\"\"\n",
        "    r = pd.DataFrame(resultats)\n",
        "    r = r[r['jeu_evalue'] == jeu].pivot_table(index='modele', columns='metrique', values='valeur')\n",
        "    return pd.DataFrame({'MAE (M$)': (r['MAE'] / 1e6).round(1),\n",
        "                         'RMSE (M$)': (r['RMSE'] / 1e6).round(1),\n",
        "                         'WAPE (%)': (r['WAPE'] * 100).round(1)}).sort_values('WAPE (%)')\n",
        "\n",
        "\n",
        "MODELES = {\n",
        "    'Ridge (niveau)': (creer_ridge(), 'niveau'),\n",
        "    'Ridge (croissance)': (creer_ridge(), 'croissance'),\n",
        "    'Gradient Boosting (niveau)': (creer_gbr(), 'niveau'),\n",
        "    'Gradient Boosting (croissance)': (creer_gbr(), 'croissance'),\n",
        "}\n",
        "\n",
        "# Évite les doublons si la cellule est relancée : on ne garde que les références\n",
        "resultats[:] = [r for r in resultats if r['modele'] in REFERENCES]\n",
        "\n",
        "for nom, (modele, cible) in MODELES.items():\n",
        "    predictions_val[nom] = evaluer(nom, modele, cible) / 1e9\n",
        "\n",
        "print('Prévisions sur la validation (milliards USD) :')\n",
        "display(predictions_val.round(3))\n",
        "print('Validation croisée (2017–2021), triée par WAPE :')\n",
        "display(tableau_recap('validation croisée (2017–2021)'))\n",
        "print('Validation (2020–2021), triée par WAPE :')\n",
        "display(tableau_recap('validation (2020–2021)'))"
      ]
